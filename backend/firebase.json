{
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "lib/**/*.test.js",
        "lib/**/*.test.js.map",
        "lib/**/*.test.d.ts",
        "*.local",
        "firebase-debug.log"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint", "npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "functions": { "port": 5001 },
    "ui": { "enabled": true }
  }
}
