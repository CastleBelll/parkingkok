{
  "name": "parkingkok-backend",
  "version": "0.1.0",
  "private": true,
  "description": "주차콕 Firebase Cloud Functions (2nd gen) — account/subscription/referral/reward/config only",
  "license": "UNLICENSED",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && node --test \"lib/**/*.test.js\"",
    "clean": "rm -rf lib",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
