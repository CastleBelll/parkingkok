<?xml version="1.0" encoding="utf-8"?>
<!--
  A car inside a location pin — the mark docs/10 §1 names, drawn once here and mirrored by
  BrandPin in the app.

  Everything sits inside the adaptive-icon safe zone: the launcher may mask this to a
  circle, a squircle or a rounded square, and only the middle 66dp of the 108dp canvas is
  guaranteed to survive. The pin spans y=25..83 and x=33..75, well within it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- pin: head circle plus a tail whose shoulders start inside the head, so the
         circle drawn over it hides the join -->
    <path
        android:fillColor="#2563EB"
        android:pathData="M45.5,60.5 L62.5,60.5 L54,83 Z" />
    <path
        android:fillColor="#2563EB"
        android:pathData="M54,46 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0" />
    <!-- car, side profile, white -->
    <group android:translateX="40.5" android:translateY="38.5">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,10.2 L0.3,7.7 L1.6,6.8 L7,6.2 L10.3,1.9 L12.4,0.6 L16.7,0.6 L19.2,2 L21.6,6 L25.9,6.8 L27,8 L27,10.2 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M7,10.8 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M20.5,10.8 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0" />
        <path
            android:fillColor="#2563EB"
            android:pathData="M7,10.8 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />
        <path
            android:fillColor="#2563EB"
            android:pathData="M20.5,10.8 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />
    </group>
</vector>
