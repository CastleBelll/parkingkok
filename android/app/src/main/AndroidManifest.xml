<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Motion signal for smart detection. Runtime permission on Android 10+
         (docs/04_ANDROID_IMPLEMENTATION.md §19). Denial disables automatic detection
         only; manual parking records stay fully available. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Reboot drops the Play services transition subscription; this lets the app
         re-register it (§6). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bounded Fused Location capture around a confirmed driving window
         (docs/04_ANDROID_IMPLEMENTATION.md §2, §19). Coarse is declared alongside fine
         because the system offers the user an approximate-only choice, and a coarse grant
         still supports the DRIVING_CANDIDATE confirmation window. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Without this the OS stops delivering location to the PendingIntent as soon as the
         app leaves the foreground — which is every real drive (§3). It is requested
         separately and only after the user opts into Smart Detection, never at first
         launch, and denial is not an app failure. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- docs/04_ANDROID §2a: the drive-scoped capture service. Measured on 2026-09-20 —
         without a foreground service, background location is throttled to roughly nothing
         (0 deliveries in 3 minutes against ~12 expected), and a doze exemption alone does
         not lift it. The service lives only while one bounded Fused Location request does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- The car link (docs/05 §3a "The car link"). From Android 12 this grant is what
         makes the system deliver ACL_CONNECTED/ACL_DISCONNECTED at all; without it the
         app simply never hears about a car, which costs accuracy and nothing else. It is
         requested only alongside Smart Detection and denial is not an app failure.
         BLUETOOTH is its pre-12 predecessor and is capped accordingly.
         No scanning permission is declared: the app never discovers devices, it only
         hears that one already paired has attached or detached. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <!-- The label prompt asks what a just-closed session was (docs/05 §9 labelling).
         Runtime permission on Android 13+, requested from the diagnostics screen only and
         never at first launch. Denial suppresses the prompt and is counted; it breaks
         nothing, and the in-app labelling screen keeps working. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ParkingpinApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Parkingpin">

        <!-- ══ Firebase Analytics starts switched OFF (docs/07 "동의") ══════════════
             The SDK collects by default, and `FirebaseInitProvider` runs before
             `Application.onCreate`, so by the time any of our code could object the first
             automatic events would already be queued. These flags are what make the
             consent gate real rather than advisory: nothing is collected or uploaded until
             `FirebaseAnalyticsCollectionControl` turns collection on, which happens only
             while the stored consent flag is true.

             `firebase_analytics_collection_enabled`, not `..._deactivated`: deactivated is
             permanent and could never be undone at runtime, so consenting later would do
             nothing. This one is a default that `setAnalyticsCollectionEnabled` overrides.

             The adid/ssaid flags stay off permanently. docs/17 §3 fixes the property list
             and no advertising or device identifier is on it; docs/17 §5 forbids invasive
             fingerprinting outright. There is no consent state in which the app wants
             these, so they are not wired to the toggle. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Parkingpin.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets a camera app write one capture into our cache directory (FR-007). The
             app declares no CAMERA permission: ACTION_IMAGE_CAPTURE requires it only from
             an app that declares it, so not declaring it is what keeps the photo flow
             permission-free (docs/04_ANDROID_IMPLEMENTATION.md §19). Stored parking photos
             are not reachable through this provider - file_paths.xml exposes the camera
             scratch directory and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Target of the Activity Transition PendingIntent. Not exported: only Play
             services holds the PendingIntent, and a PendingIntent target does not need
             to be exported to be delivered. -->
        <receiver
            android:name=".detection.ActivityTransitionReceiver"
            android:exported="false" />

        <!-- docs/04_ANDROID §2a. Started by `FusedLocationSessionRegistrar.request` and
             stopped by `remove`, so its lifetime is exactly one bounded capture's. Never
             permanent: a parked phone runs no service, which is what CLAUDE.md's rule
             against a standing foreground service actually forbids. -->
        <service
            android:name=".detection.DrivingLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Target of the Fused Location PendingIntent. Not exported, for the same
             reason as the transition receiver. -->
        <receiver
            android:name=".detection.LocationUpdateReceiver"
            android:exported="false" />

        <!-- Target of the candidate notification's 주차 아님 action (docs/05 §10a). Not
             exported: only the notification holds the PendingIntent, and a PendingIntent
             target does not need to be exported to be delivered. Rejecting must cost no
             app launch — it is the answer the detector learns most from, so it is the
             cheapest thing on the notification. -->
        <receiver
            android:name=".detection.ParkingCandidateReceiver"
            android:exported="false" />

        <!-- The car link (docs/05 §3a). Declared in the manifest rather than registered
             at runtime because the signal is worth nothing unless it arrives while the app
             is not running — the disconnect happens as the driver walks away. ACL_CONNECTED
             and ACL_DISCONNECTED are on the platform's implicit-broadcast exception list,
             so a manifest receiver still receives them on Android 8+.

             Exported: these are system broadcasts, and an unexported receiver would not
             get them. Nothing is trusted from the intent beyond the Bluetooth device class,
             and a spoofed connect can at worst open a detection window that produces a
             candidate the user declines. -->
        <receiver
            android:name=".detection.CarLinkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Target of the label-prompt notification actions. Not exported: only the
             notification holds the PendingIntent, and a PendingIntent target does not need
             to be exported to be delivered. -->
        <receiver
            android:name=".trace.TraceLabelPromptReceiver"
            android:exported="false" />

        <!-- ══ Home-screen widgets (docs/06 §7a, docs/04_ANDROID_IMPLEMENTATION.md §10) ══
             Two providers, 2x2 and 4x2, sharing one Glance widget so both sizes appear in
             the picker and land at the size the user chose. Exported because the launcher
             is a different app and has to be able to bind them.

             The state a widget draws from is a projection derived from Room, never a
             second copy of the parking, and it carries no coordinate, address or photo
             (docs/09). -->
        <receiver
            android:name=".widget.ParkingCompactWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.ParkingWideWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_wide_info" />
        </receiver>

        <!-- Must be exported to receive the system broadcasts. -->
        <receiver
            android:name=".detection.RegistrationRecoveryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
