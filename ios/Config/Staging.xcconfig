#include "Base.xcconfig"

// Internal / TestFlight build. Same bundle id as PROD — see Dev.xcconfig for why.
PK_BUNDLE_ID = $(PK_BUNDLE_ID_BASE)
PK_DISPLAY_NAME = 주차핀
PK_APP_ENV = staging

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) PK_STAGING

// Firebase project per environment (docs/18 §13): DEV and STAGING use parkingpin-dev.
// The Prod options file is excluded so it can never ship in a non-production build.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) */Firebase/Environments/Prod/GoogleService-Info.plist
