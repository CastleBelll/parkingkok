// Shared build settings for every configuration (docs/04_IOS_IMPLEMENTATION.md §17).
// Environment-specific overrides live in Dev/Staging/Prod.xcconfig.

// ── Platform baseline (ADR-002, docs/04 §1) ─────────────────────────────────
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
SDKROOT = iphoneos

// ── Swift 6 language mode + strict concurrency (docs/04 §18, docs/16 §1) ────
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES

// CI treats Swift 6 concurrency warnings as errors (docs/04 §18).
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES

// ── Product identity ────────────────────────────────────────────────────────
PK_BUNDLE_ID_BASE = com.sjstudioz.parkingpin
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ── App Group (docs/06 §6) ──────────────────────────────────────────────────
// The container the app and the widget extension share. Derived from the per-config
// bundle id on purpose: DEV, STAGING and PROD each get their own, so three builds
// installed side by side cannot overwrite one another's active parking.
PK_APP_GROUP = group.$(PK_BUNDLE_ID)

// ── Signing: simulator builds need no identity; CI injects the rest ─────────
// Team ID is never committed (docs/18_CI_CD_AUTOMATED_RELEASE.md keeps it in
// APPLE_TEAM_ID). Device builds pass it in:
//   xcodebuild ... PK_DEVELOPMENT_TEAM=<team> -allowProvisioningUpdates
PK_DEVELOPMENT_TEAM =

// …which works for `xcodebuild` and not for Xcode, where nothing passes anything
// and the Team ends up None. A capability cannot be registered without a Team, so
// opening the project and adding the App Group failed with "Communication with
// Apple failed" until this existed.
//
// `Local.xcconfig` is gitignored and holds one line:
//   PK_DEVELOPMENT_TEAM = <your team id>
// The `?` makes it optional, so a fresh checkout and CI both build without it.
// It comes after the default above because in an xcconfig the later assignment wins.
#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(PK_DEVELOPMENT_TEAM)
CODE_SIGN_STYLE = Automatic

// Simulator builds are signed ad-hoc rather than not at all. `simctl` creates the
// App Group container (docs/06 §6) from the *embedded* entitlements, so an unsigned
// build carries none and `containerURL(forSecurityApplicationGroupIdentifier:)` returns
// nil — measured, not assumed. Ad-hoc needs no identity, no team and no provisioning
// profile, so this stays true on CI and on a fork PR with no secrets.
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
CODE_SIGN_STYLE[sdk=iphonesimulator*] = Manual
CODE_SIGNING_REQUIRED[sdk=iphonesimulator*] = NO

ENABLE_USER_SCRIPT_SANDBOXING = YES
